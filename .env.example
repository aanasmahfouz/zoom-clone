# ==============================================
# Yoom Video Conferencing - Environment Variables
# ==============================================

# Next.js Telemetry (Optional)
NEXT_TELEMETRY_DISABLED=1

# Clerk Authentication (https://clerk.com)
# Obtain these from your Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Route Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stream Video & Audio SDK (https://getstream.io/video/)
# Obtain these from your Stream Dashboard -> Video & Audio
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_SECRET_KEY=your_stream_secret_key

# Application Base URL (Local Development or Deployed Domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
